[
	{
		"name": "recalls name and preference across turns",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 2,
		"passRatio": 0.5,
		"turns": [
			{
				"text": "My name is Kevin, please remember that.",
				"expect": { "routed": "chat" }
			},
			{
				"text": "I really love green tea.",
				"expect": { "routed": "chat", "factInDb": { "value": "tea" } }
			},
			{
				"text": "What's the weather like as a topic?",
				"expect": { "routed": "chat" }
			},
			{
				"text": "What is my name?",
				"expect": {
					"routed": "chat",
					"replyIncludes": ["Kevin"],
					"recallsFact": { "value": "Kevin" }
				}
			},
			{
				"text": "What do I like to drink?",
				"expect": {
					"routed": "chat",
					"replyIncludes": ["tea"],
					"recallsFact": { "value": "tea" }
				}
			}
		]
	},
	{
		"name": "commands, questions and small talk leave no fact",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 2,
		"passRatio": 0.5,
		"turns": [
			{
				"text": "Turn on the kitchen lights please.",
				"expect": { "noFactInDb": { "value": "lights" } }
			},
			{
				"text": "Do you have a spa around here?",
				"expect": { "noFactInDb": { "value": "spa" } }
			},
			{
				"text": "Nice weather today, isn't it?",
				"expect": { "noFactInDb": { "value": "weather" } }
			}
		]
	},
	{
		"name": "duplicate statement corroborates instead of duplicating",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 2,
		"passRatio": 0.5,
		"turns": [
			{
				"text": "I really love green tea.",
				"expect": { "routed": "chat", "factInDb": { "value": "tea" } }
			},
			{
				"text": "Like I said, green tea is my favorite drink.",
				"expect": {
					"routed": "chat",
					"factCountAtMost": { "value": "tea", "count": 1 }
				}
			}
		]
	},
	{
		"name": "contradiction supersedes the old preference",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 2,
		"passRatio": 0.5,
		"turns": [
			{
				"text": "I love coffee, it's my favorite drink.",
				"expect": { "routed": "chat", "factInDb": { "value": "coffee" } }
			},
			{
				"text": "Tell me something interesting.",
				"expect": { "routed": "chat" }
			},
			{
				"text": "Actually I quit coffee, I can't stand it anymore.",
				"expect": { "routed": "chat" }
			},
			{
				"text": "Do I like coffee?",
				"expect": {
					"routed": "chat",
					"replyExcludes": ["you love coffee", "your favorite"]
				}
			}
		]
	},
	{
		"name": "a past-tense preference is not claimed as current",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 2,
		"passRatio": 0.5,
		"turns": [
			{
				"text": "I used to like coffee, now I only drink tea.",
				"expect": { "routed": "chat", "factInDb": { "value": "tea" } }
			},
			{
				"text": "Tell me something interesting.",
				"expect": { "routed": "chat" }
			},
			{
				"text": "What do I drink?",
				"expect": {
					"routed": "chat",
					"replyIncludes": ["tea"],
					"replyExcludes": [
						"you like coffee",
						"you love coffee",
						"your favorite"
					],
					"recallsFact": { "value": "tea" }
				}
			}
		]
	}
]
