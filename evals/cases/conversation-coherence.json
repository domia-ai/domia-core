[
	{
		"name": "multi-turn coherence: no repetition loops, no user echo, no time non-sequiturs",
		"suite": "conversation",
		"language": "en",
		"isolate": "conversation",
		"runs": 3,
		"passRatio": 0.6,
		"turns": [
