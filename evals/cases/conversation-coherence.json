						"in the afternoon",
						"in the evening"
					]
				}
			},
			{
				"text": "Tell me a joke.",
				"expect": { "routed": "chat", "noRepeat": true, "noEcho": true }
			},
			{
				"text": "What is your favorite fruit?",
				"expect": {
					"routed": "chat",
					"noRepeat": true,
					"noEcho": true,
					"replyExcludes": [
						"in the morning",
						"in the afternoon",
						"in the evening"
					]
				}
			},
			{
				"text": "Tell me something about Costa Rica.",
				"expect": {
					"routed": "chat",
					"noRepeat": true,
					"noEcho": true,
					"replyExcludes": [
