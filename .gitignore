# Node.js dependency directory
node_modules/

# Compiled JavaScript files
build/

# local env files (per-instance); .env.example is tracked
.env*
!.env.example

# Personal cursor configuration files
.cursor/

.DS_Store

# SQLite
/data/db/

# Temp files for local testing
/tmp/
/**/tmp/
/**/mic_test_output.wav

# ML model files — large binary blobs, fetched via `npm run setup:models`
/data/models/

# MQTT runtime files
/data/mqtt/

# Runtime logs (all contents of /log/ are local-only)
/log/*

# Ignore Mosquitto password file (security)
/config/mqtt/password.txt

# Bench artifacts
/evals/bench-results/
/evals/results/
