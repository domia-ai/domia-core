# Copy to .env (or .env.<name>) per Domia instance — each is a device identity.
# Launch:  DOMIA_ENV=.env.<name> npm run dev   |   reset: DOMIA_ENV=.env.<name> npm run db:reset
NODE_ENV=development
DEBUG=domia:*

# Canonical DB path (repo-root relative, under data/db/). Runtime + drizzle + reset all use this.
DATABASE_URL=data/db/<name>.db

HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=3100

# Per-device identity
DOMIA_KEY=DOMIA_<NAME>

GRPC_HOST=0.0.0.0
GRPC_PORT=5052
GRPC_DEADLINE_MS=10000
GRPC_STREAM_IDLE_MS=30000

DB_STUDIO_PORT=6789
DOMIA_LOG_FILE=log/<name>.log
OLLAMA_HOST=http://localhost:11434
