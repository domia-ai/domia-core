# A node is just an envelope: a DB file + ports + a principal key. It boots neutral —
# its role (hub / device / satellite) comes from a template applied in the console, and one
# node hosts many identities (DB-driven, no DOMIA_KEYS). Copy to .env (node A) or .env.b
# (a 2nd process, for multi-node mesh tests). Names are agnostic on purpose.
# Launch:  DOMIA_ENV=.env.<id> npm run dev   |   reset: DOMIA_ENV=.env.<id> npm run db:reset
NODE_ENV=development
DEBUG=domia:*

# Canonical DB path (repo-root relative, under data/db/). Runtime + drizzle + reset all use this.
DATABASE_URL=data/db/<id>.db

HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=3100

# Principal identity key for this node (a label, not a role — nothing branches on it)
DOMIA_KEY=DOMIA_<ID>

GRPC_HOST=0.0.0.0
GRPC_PORT=5052

DB_STUDIO_PORT=6789
DOMIA_LOG_FILE=log/<id>.log
DOMIA_MESH_SECRET=change-me-shared-mesh-secret

# --- Mesh secret rotation (optional). Set NEXT on every node, restart them one by one: nodes sign
# with NEXT and accept both secrets for `domia.meshSecretGraceMs` (DB, default 24h). Then move
# NEXT into DOMIA_MESH_SECRET, unset NEXT, restart again. POST /mesh/rotate reports the posture.
# DOMIA_MESH_SECRET_NEXT=

# --- TLS (optional, default off = plaintext mesh). Both CERT and KEY enable HTTPS + gRPC TLS;
# CA is what this node trusts for peers (and presents for client auth). make dev-certs generates
# a self-signed set under data/certs/. Peers learn the scheme from the heartbeat.
# DOMIA_TLS_CERT_FILE=data/certs/domia.crt
# DOMIA_TLS_KEY_FILE=data/certs/domia.key
# DOMIA_TLS_CA_FILE=data/certs/ca.crt
# DOMIA_TLS_REQUIRE_CLIENT_CERT=0

# --- OpenTelemetry (optional, default off = nothing loaded). OTLP/HTTP traces endpoint.
# DOMIA_OTEL_EXPORTER_URL=http://127.0.0.1:4318/v1/traces
# DOMIA_OTEL_SERVICE_NAME=domia-core
