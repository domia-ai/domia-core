# App environment
NODE_ENV=development
DEBUG=domia:*

# Database
DATABASE_URL=../../data/db/[smart/dump].db
DATABASE_URL_CLI=file:data/db/[smart/dump].db

# HTTP server
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=3000

# Domia identification
DOMIA_KEY=DOMIA_UNIQUE_ID

# Python binary path (used to run Python scripts, default: .venv/bin/python3)
PYTHON_BIN=.venv/bin/python3

# ML server (FastAPI host for inference engines: TTS, STT)
DOMIA_ML_HOST=127.0.0.1
DOMIA_ML_PORT=5051
DOMIA_ML_READY_TIMEOUT_MS=30000
