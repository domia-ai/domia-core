# App environment
NODE_ENV=development
DEBUG=domia:*

# Database
DATABASE_URL=../../data/db/[smart/dump].db
DATABASE_URL_CLI=file:data/db/[smart/dump].db

# HTTP server
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=3000

# Domia identification
DOMIA_KEY=DOMIA_UNIQUE_ID

# gRPC inter-DOMIA
GRPC_HOST=127.0.0.1
GRPC_PORT=5052
GRPC_DEADLINE_MS=10000
GRPC_STREAM_IDLE_MS=30000

# Logging — optional file path for JSON-line persistent logs (in addition to stdout)
DOMIA_LOG_FILE=log/[smart/dump].log

# Ollama LLM host — default uses localhost (IPv6/IPv4) which works for both Docker
# (compose maps it) and native installs. In Docker-to-Docker setups override to
# the service name, e.g. OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://localhost:11434
