{
	"name": "domia-core",
	"version": "0.0.1",
	"description": "Domia core",
	"main": "index.js",
	"author": "kevin Castillo <kecoco16@gmail.com>",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "tsc && tsc-alias",
		"start": "node ./build/index.js",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"prepare": "husky",
		"dev:smart": "dotenvx run -f .env -- nodemon --watch src --ext ts,js --ignore src/**/*.spec.ts --exec 'ts-node -r tsconfig-paths/register ./src/index.ts'",
		"dev:dump": "dotenvx run -f .env.dump -- nodemon --watch src --ext ts,js --ignore src/**/*.spec.ts --exec 'ts-node -r tsconfig-paths/register ./src/index.ts'",
		"stop": "bash scripts/stop-all.sh",
		"db:generate:smart": "dotenvx run -f .env -- drizzle-kit generate",
		"db:generate:dump": "dotenvx run -f .env.dump -- drizzle-kit generate",
		"db:pull:smart": "dotenvx run -f .env -- drizzle-kit pull",
		"db:pull:dump": "dotenvx run -f .env.dump -- drizzle-kit pull",
		"db:migrate:smart": "dotenvx run -f .env -- drizzle-kit migrate",
		"db:migrate:dump": "dotenvx run -f .env.dump -- drizzle-kit migrate",
		"db:studio:smart": "dotenvx run -f .env -- drizzle-kit studio --port 6789",
		"db:studio:dump": "dotenvx run -f .env.dump -- drizzle-kit studio --port 6790",
		"db:push:smart": "dotenvx run -f .env -- drizzle-kit push",
		"db:push:dump": "dotenvx run -f .env.dump -- drizzle-kit push",
		"db:reset:smart": "rm data/db/smart.db && rm -rf drizzle && npm run db:generate:smart && npm run db:migrate:smart",
		"db:reset:dump": "rm data/db/dump.db && rm -rf drizzle && npm run db:generate:dump && npm run db:migrate:dump",
		"dev-cli": "dotenvx run -f .env -- ts-node -r tsconfig-paths/register src/cli/dev/index.ts",
		"proto:gen": "protoc --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated/proto --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false,esModuleInterop=true,oneof=unions --proto_path=proto proto/*.proto",
		"setup:models": "bash scripts/download-models.sh all",
		"setup:models:whisper": "bash scripts/download-models.sh whisper",
		"setup:models:kokoro": "bash scripts/download-models.sh kokoro",
		"setup:models:moonshine": "bash scripts/download-models.sh moonshine",
		"setup:models:kws": "bash scripts/download-models.sh kws",
		"setup:models:vad": "bash scripts/download-models.sh vad"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.48.4",
		"@eslint/js": "^9.28.0",
		"@faker-js/faker": "^10.4.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/debug": "^4.1.12",
		"@types/node": "^22.15.29",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.33.1",
		"@typescript-eslint/parser": "^8.33.1",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.4.1",
		"globals": "^16.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"nodemon": "^3.1.10",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"ts-proto": "^2.11.7",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.33.1"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.12.0",
		"better-sqlite3": "^12.9.0",
		"chalk": "^5.4.1",
		"commander": "^14.0.0",
		"debug": "^4.4.1",
		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "^0.8.2",
		"fastify": "^5.5.0",
		"inquirer": "^13.4.3",
		"mqtt": "^5.13.3",
		"nice-grpc": "^2.1.16",
		"nice-grpc-common": "^2.0.3",
		"ollama": "^0.6.3",
		"sherpa-onnx-node": "^1.13.1",
		"ws": "^8.20.0",
		"zod": "^3.25.50"
	}
}
