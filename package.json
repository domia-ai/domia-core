{
	"name": "domia-core",
	"version": "0.0.1",
	"description": "Domia core",
	"main": "index.js",
	"author": "kevin Castillo <kecoco16@gmail.com>",
	"license": "Apache-2.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "npm run evals -- pure",
		"build": "rm -rf build && tsc && tsc-alias",
		"start": "dotenvx run -f ${DOMIA_ENV:-.env} -- node ./build/index.js",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"validate": "npm run typecheck && npm run lint && npm run format",
		"validate:fix": "npm run lint:fix && npm run format:fix && npm run typecheck",
		"prepare": "husky",
		"dev": "dotenvx run -f ${DOMIA_ENV:-.env} -- nodemon --watch src --ext ts,js --ignore src/**/*.spec.ts --exec 'ts-node -r tsconfig-paths/register ./src/index.ts'",
		"dev:b": "DOMIA_ENV=.env.b npm run dev",
		"stop": "bash scripts/stop-all.sh",
		"db:generate": "dotenvx run -f ${DOMIA_ENV:-.env} -- drizzle-kit generate",
		"db:pull": "dotenvx run -f ${DOMIA_ENV:-.env} -- drizzle-kit pull",
		"db:migrate": "dotenvx run -f ${DOMIA_ENV:-.env} -- drizzle-kit migrate",
		"db:studio": "dotenvx run -f ${DOMIA_ENV:-.env} -- sh -c 'drizzle-kit studio --port ${DB_STUDIO_PORT:-6789}'",
		"db:push": "dotenvx run -f ${DOMIA_ENV:-.env} -- drizzle-kit push",
		"db:reset": "dotenvx run -f ${DOMIA_ENV:-.env} -- bash scripts/db-reset.sh",
		"db:reset:b": "DOMIA_ENV=.env.b npm run db:reset",
		"dev-cli": "dotenvx run -f ${DOMIA_ENV:-.env} -- ts-node -r tsconfig-paths/register src/cli/dev/index.ts",
		"proto:gen": "protoc --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated/proto --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false,esModuleInterop=true,oneof=unions --proto_path=proto proto/*.proto",
		"setup:models": "bash scripts/download-models.sh all",
		"evals": "dotenvx run -q -f ${DOMIA_ENV:-.env} -- npx tsx evals/index.ts",
		"typecheck:evals": "tsc --noEmit -p tsconfig.evals.json",
		"check": "npm run build && npm run lint && npm run typecheck:evals"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.67.0",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.4.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/debug": "^4.1.13",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.3",
		"ts-node": "^10.9.2",
		"ts-proto": "^2.11.8",
		"tsc-alias": "^1.8.17",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.22.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.4"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.12.0",
		"@grpc/grpc-js": "^1.14.4",
		"@huggingface/transformers": "^4.2.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"better-sqlite3": "^12.10.0",
		"bonjour-service": "^1.4.1",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"debug": "^4.4.3",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"esphome-client": "^1.3.1",
		"fastify": "^5.8.5",
		"inquirer": "^13.4.3",
		"livekit-server-sdk": "^2.16.0",
		"minisearch": "^7.2.0",
		"mqtt": "^5.15.1",
		"nice-grpc": "^2.1.16",
		"nice-grpc-common": "^2.0.3",
		"ollama": "^0.6.3",
		"onnxruntime-node": "^1.27.0",
		"openai": "^6.43.0",
		"sherpa-onnx-node": "1.13.5",
		"ws": "^8.21.0",
		"zod": "^4.4.3"
	},
	"optionalDependencies": {
		"@livekit/rtc-node": "^0.13.30"
	},
	"overrides": {
		"onnxruntime-node": "$onnxruntime-node",
		"sherpa-onnx-darwin-arm64": "1.13.5",
		"sherpa-onnx-darwin-x64": "1.13.5",
		"sherpa-onnx-linux-arm64": "1.13.5",
		"sherpa-onnx-linux-x64": "1.13.5",
		"sherpa-onnx-win-x64": "1.13.5",
		"sherpa-onnx-win-ia32": "1.13.5"
	}
}
