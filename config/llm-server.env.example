# Per-box overrides for scripts/llm-server.sh (copy to config/llm-server.env, gitignored).
# The launcher reads this file first, then the environment the unit passes, then its defaults.
# Every line is optional. Relative LLM_GGUF / LLM_CHAT_TEMPLATE paths resolve against the repo root. Values here survive `make llm-service` re-renders; apply with `pkill -x llama-server`.

# LLAMA_SERVER_BIN=$HOME/src/llama.cpp/build/bin/llama-server
# LLM_GGUF=data/models/gguf/llama-3.2-3b-instruct-q4_k_m.gguf
# LLM_HOST=0.0.0.0
# LLM_PORT=11435
# LLM_CTX=4096                 # total context, shared by all slots (-np)
# LLM_CHAT_TEMPLATE=           # path to a .jinja file, empty = the GGUF's own
# LLM_EXTRA_FLAGS=             # anything else llama-server accepts
# LLM_NO_WARMUP=0
# LLM_CACHE_RAM_MB=256         # host prompt cache cap in MiB; 0 disables it, -1 uncaps it
# LLM_SPEC_TYPE=               # self-speculative decoding, no draft model: LLM_SPEC_TYPE=ngram-mod

# Jetson Orin 8 GB hub (templates/jetson*.json presume two server slots):
# LLM_CTX=8192
# LLM_EXTRA_FLAGS="-np 2 -ctk q8_0 -ctv q8_0"
